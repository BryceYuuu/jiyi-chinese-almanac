.theme-indigo {
  --color-bg: #F3F5F6;
  --color-surface: #FBFCFD;
  --color-surface-strong: #FFFFFF;
  --color-primary: #50677B;
  --color-primary-soft: #E6EBEF;
  --color-primary-wash: rgba(80, 103, 123, 0.09);
  --color-primary-border: rgba(80, 103, 123, 0.28);
  --color-primary-border-strong: rgba(80, 103, 123, 0.44);
  --color-secondary: #9A7446;
  --color-line: #DEE3E7;
  --color-control-bg: #E9EDF0;
  --shadow-card: 0 8rpx 24rpx rgba(45, 60, 74, 0.055);
