.theme-gold {
  --color-bg: #F7EEDB;
  --color-surface: #FCF5E6;
  --color-surface-strong: #FFF8EA;
  --color-professional-surface: #F9F0DB;
  --color-primary: #9B6D22;
  --color-primary-soft: #F5EACF;
  --color-primary-wash: rgba(155, 109, 34, 0.09);
  --color-primary-border: rgba(155, 109, 34, 0.28);
  --color-primary-border-strong: rgba(155, 109, 34, 0.44);
  --color-secondary: #A17A3C;
  --color-line: #E5D7B8;
  --color-control-bg: #EFE3CA;
  --shadow-card: 0 10rpx 28rpx rgba(83, 65, 32, 0.07), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  --shadow-soft: 0 5rpx 16rpx rgba(83, 65, 32, 0.05);
  --shadow-primary: 0 6rpx 16rpx rgba(155, 109, 34, 0.13);
}
