page {
  --color-bg: #F8F5EF;
  --color-surface: #FFFCF7;
  --color-surface-strong: #FFFFFF;
  --color-text: #222222;
  --color-muted: #666666;
  --color-subtle: #918A82;
  --color-primary: #C94732;
  --color-primary-soft: #F7E9E5;
  --color-primary-wash: rgba(201, 71, 50, 0.08);
  --color-primary-border: rgba(201, 71, 50, 0.28);
  --color-primary-border-strong: rgba(201, 71, 50, 0.42);
  --color-secondary: #B58A4A;
  --color-line: #EAE3D9;
  --color-control-bg: #F1ECE4;
  --color-status-positive: #3F7468;
  --color-status-positive-soft: #E4EEE9;
  --color-status-neutral: #6D6862;
  --color-status-neutral-soft: #EFECE7;
  --color-status-caution: #9A7139;
  --color-status-caution-soft: #F6EEDC;
  --color-status-ended: #7C766F;
  --color-status-ended-soft: #ECE9E4;
  --shadow-card: 0 8rpx 24rpx rgba(67, 49, 30, 0.055);
  --shadow-soft: 0 4rpx 14rpx rgba(67, 49, 30, 0.04);
  --shadow-primary: 0 6rpx 16rpx rgba(201, 71, 50, 0.12);
  --radius-card: 16rpx;
  --radius-pill: 999rpx;
  --space-page-x: 32rpx;
  --space-page-y: 32rpx;
  --space-section: 28rpx;
  --space-card: 28rpx;
}

.theme-cinnabar {
  --color-bg: #F8F5EF;
  --color-surface: #FFFCF7;
  --color-surface-strong: #FFFFFF;
  --color-primary: #C94732;
  --color-primary-soft: #F7E9E5;
  --color-primary-wash: rgba(201, 71, 50, 0.08);
  --color-primary-border: rgba(201, 71, 50, 0.28);
  --color-primary-border-strong: rgba(201, 71, 50, 0.42);
  --color-secondary: #B58A4A;
  --color-line: #EAE3D9;
  --color-control-bg: #F1ECE4;
  --shadow-card: 0 8rpx 24rpx rgba(67, 49, 30, 0.055);
  --shadow-soft: 0 4rpx 14rpx rgba(67, 49, 30, 0.04);
  --shadow-primary: 0 6rpx 16rpx rgba(201, 71, 50, 0.12);
}

.theme-pine {
  --color-bg: #F3F6F2;
  --color-surface: #FBFDF9;
  --color-surface-strong: #FFFFFF;
  --color-primary: #3F7468;
  --color-primary-soft: #E3EEE9;
  --color-primary-wash: rgba(63, 116, 104, 0.09);
  --color-primary-border: rgba(63, 116, 104, 0.28);
  --color-primary-border-strong: rgba(63, 116, 104, 0.44);
  --color-secondary: #A47D43;
  --color-line: #DDE6DF;
  --color-control-bg: #EAEFEB;
  --shadow-card: 0 8rpx 24rpx rgba(43, 70, 59, 0.055);
  --shadow-soft: 0 4rpx 14rpx rgba(43, 70, 59, 0.04);
