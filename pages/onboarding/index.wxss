.setup-page {
  padding-top: 22rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid var(--color-primary-border-strong);
  border-radius: 8rpx;
  color: var(--color-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 23rpx;
}

.brand-name {
  margin-left: 12rpx;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 600;
}

.local-badge {
  margin-left: auto;
  padding: 8rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-control-bg);
  color: var(--color-muted);
  font-size: 22rpx;
}

.setup-header {
  margin-top: 48rpx;
}

.setup-title {
  display: block;
  color: var(--color-text);
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.18;
}

.setup-subtitle {
  display: block;
  width: 92%;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.form-card {
  margin-top: 34rpx;
  padding: 0 28rpx;
}

.form-card-birth-focus {
  margin-top: 28rpx;
  background: linear-gradient(155deg, var(--color-surface-strong), var(--color-primary-soft));
}

.form-section {
  padding: 28rpx 0;
}

.birth-section-help {
  margin-top: 7rpx;
}

.section-label {
  display: block;
  color: var(--color-text);
  font-size: 27rpx;
  font-weight: 600;
}

.avatar-editor {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.avatar-button {
  position: relative;
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  border-radius: 50%;
  line-height: 1;
}

.avatar-preview,
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border-radius: 50%;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.avatar-change {
  position: absolute;
  right: -8rpx;
  bottom: -2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 54rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border: 2rpx solid var(--color-surface);
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1;
}

.avatar-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.avatar-title {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
}

.avatar-desc {
  margin-top: 7rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.section-help {
  display: block;
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 22rpx;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  color: var(--color-muted);
  font-size: 22rpx;
}

.field-label-row {
  display: flex;
  min-height: 38rpx;
  align-items: center;
  justify-content: space-between;
}

.field-clear {
  width: auto;
  min-width: 0;
  max-width: none;
  height: 38rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 20rpx;
  line-height: 38rpx;
}

.optional {
  color: var(--color-subtle);
  font-size: 22rpx;
}

.field-control,
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 88rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: #FFFFFF;
  color: var(--color-text);
  font-size: 26rpx;
}

.input-placeholder,
.field-placeholder {
  color: var(--color-subtle);
}

.picker-arrow {
  color: var(--color-muted);
  font-size: 36rpx;
}

.field-help {
  display: block;
  margin-top: 10rpx;
  color: var(--color-subtle);
  font-size: 20rpx;
  line-height: 1.45;
}

.zodiac-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: var(--color-primary-soft);
}

.bazi-preview {
  margin-top: 18rpx;
  padding: 22rpx 20rpx 18rpx;
  border: 1rpx solid var(--color-primary-border);
  border-radius: 12rpx;
  background: linear-gradient(145deg, var(--color-primary-soft), rgba(255, 255, 255, 0.62));
}

.bazi-preview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.bazi-preview-head > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.bazi-preview-title {
  color: var(--color-text);
  font-size: 24rpx;
  font-weight: 600;
}

.bazi-preview-desc {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 20rpx;
}

.bazi-preview-badge {
  flex: 0 0 auto;
  padding: 6rpx 11rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.74);
  color: var(--color-primary);
  font-size: 18rpx;
}

.bazi-pillars {
  display: grid;
  margin-top: 20rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.bazi-pillar {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid var(--color-primary-border);
}

.bazi-pillar:last-child {
  border-right: 0;
}

.bazi-pillar-label {
  color: var(--color-subtle);
  font-size: 18rpx;
}

.bazi-pillar-value {
  margin-top: 7rpx;
  color: var(--color-text);
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.bazi-pillar-element {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 18rpx;
}

.bazi-elements {
  display: block;
  margin-top: 17rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-primary-border);
  color: var(--color-muted);
  font-size: 19rpx;
  text-align: center;
}

.bazi-empty-preview {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx dashed var(--color-primary-border-strong);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.42);
}

.bazi-empty-seal {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-primary-border-strong);
  border-radius: 9rpx;
  color: var(--color-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
}

.bazi-empty-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.bazi-empty-title {
  color: var(--color-text);
  font-size: 23rpx;
  font-weight: 600;
}

.bazi-empty-desc {
  margin-top: 5rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.birth-required-copy {
  display: block;
  margin-top: 18rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  text-align: center;
}

.birth-required-copy + .setup-button {
  margin-top: 12rpx;
}

.zodiac-label {
  color: var(--color-muted);
  font-size: 22rpx;
}

.zodiac-value {
  color: var(--color-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 30rpx;
  font-weight: 600;
}

.form-divider {
  height: 1rpx;
  background: var(--color-line);
}

.setup-mode {
  display: grid;
  width: 100%;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.setup-mode-item {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 112rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 18rpx;
  border: 1rpx solid var(--color-line);
  border-radius: 12rpx;
  background: #FFFFFF;
  color: var(--color-muted);
  overflow: hidden;
  text-align: left;
}

.setup-mode-active {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.mode-name {
  display: block;
  max-width: 100%;
  font-size: 25rpx;
  font-weight: 600;
}

.mode-desc {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.35;
  white-space: normal;
}

.avoid-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 0;
}

.avoid-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.avoid-title {
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
}

.avoid-desc {
  margin-top: 6rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.45;
}

.setup-button {
  width: 100% !important;
  max-width: none;
  margin-top: 26rpx;
}

.privacy-copy {
  display: block;
  margin-top: 18rpx;
  color: var(--color-subtle);
  font-size: 22rpx;
  text-align: center;
}
